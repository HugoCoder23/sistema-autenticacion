# Copia este archivo a .env y cambia los valores. Nunca subas .env al repositorio.

# MySQL
DB_USERNAME=auth
DB_PASSWORD=cambia-esta-contrasena
DB_ROOT_PASSWORD=cambia-esta-contrasena-root

# Clave para firmar los JWT (mínimo 32 caracteres, aleatoria).
# Genera una con:  openssl rand -base64 48
JWT_SECRET=reemplaza-con-una-clave-aleatoria-de-al-menos-32-caracteres
JWT_ACCESS_MINUTES=15

# Refresh token (cookie HttpOnly). Pon REFRESH_COOKIE_SECURE=true detrás de HTTPS.
REFRESH_TTL_DAYS=7
REFRESH_COOKIE_SECURE=false

# Recuperación de contraseña
PASSWORD_RESET_TTL_MINUTES=30
FRONTEND_URL=http://localhost:3000

# Bandeja de correo simulada (/api/dev/mailbox). Solo para demo: ponla en false en un entorno real.
DEV_OUTBOX_ENABLED=true

# Cuentas de demostración FICTICIAS (solo se cargan si la base está vacía)
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo1234!

# Orígenes permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000
